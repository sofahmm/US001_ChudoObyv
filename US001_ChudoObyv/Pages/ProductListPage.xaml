<Page x:Class="US001_ChudoObyv.Pages.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:US001_ChudoObyv.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductListPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Image Source="/Images/Чудо Обувь.png"/>
        <TextBlock Text="Список товаров"
                   Grid.Column="2"
                   FontSize="18"
                   Grid.ColumnSpan="3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <ListView Grid.Row="2"
                  Grid.ColumnSpan="8"
                  Grid.RowSpan="6"
                  ItemsSource="{Binding products}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="700"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Image Source="/Images/picture.png"
                               Grid.RowSpan="2"
                               Height="70"
                                   Margin="10"/>
                            <StackPanel Orientation="Horizontal"
                                    Grid.Column="1">
                                <TextBlock Text="{Binding Production.Name}"
                                       HorizontalAlignment="Center"
                                       Margin="50 0 0 0"/>
                                <TextBlock Text="|"
                                       Margin="10 0 10 0"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                    Grid.Row="1">
                                <TextBlock Text="{Binding Category.Name}"
                                       Margin="20 0 0 0"/>
                                <TextBlock Text="{Binding Res}"
                                       Margin="20 0 0 0"/>
                                <TextBlock Text="{Binding Compoud}"
                                       Margin="20 0 0 0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                   Grid.RowSpan="2"
                                   Text="{Binding Price}"
                                   Margin="0 30 10 0"/>
                        </Grid>
                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
